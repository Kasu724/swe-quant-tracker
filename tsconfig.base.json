{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@swe-quant/config": ["packages/config/src/index.ts"],
      "@swe-quant/db": ["packages/db/src/index.ts"],
      "@swe-quant/email": ["packages/email/src/index.ts"],
      "@swe-quant/shared": ["packages/shared/src/index.ts"],
      "@swe-quant/ui": ["packages/ui/src/index.ts"]
    }
  }
}

