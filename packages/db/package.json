{
  "name": "@swe-quant/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node ../../scripts/prisma-command.mjs generate --schema prisma/schema.prisma",
    "migrate": "node ../../scripts/prisma-command.mjs migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "node ../../scripts/prisma-command.mjs migrate dev --schema prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "check": "dotenv -e ../../.env -- tsx src/check.ts",
    "studio": "node ../../scripts/prisma-command.mjs studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@swe-quant/config": "workspace:*",
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
