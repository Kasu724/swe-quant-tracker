# Use the Supavisor transaction pooler for serverless application traffic.
# Copy the exact connection strings from the Supabase project Connect dialog.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Use the direct connection when IPv6 is available, or the Supavisor session
# pooler on port 5432 when the deployment or workstation is IPv4-only.
DIRECT_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

NEXTAUTH_URL=https://tracker.example.com
NEXTAUTH_SECRET=replace-with-a-long-random-production-secret
APP_BASE_URL=https://tracker.example.com
EMAIL_FROM=SWE-Quant Tracker <noreply@example.com>
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_URL=
ADMIN_EMAILS=admin@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
POLL_CRON=*/30 * * * *
DAILY_DIGEST_CRON=0 8 * * *
DISCORD_NOTIFICATION_CRON=* * * * *
INGESTION_CONCURRENCY=2
INGESTION_REQUEST_TIMEOUT_MS=20000
INGESTION_SOURCE_TIMEOUT_MS=120000
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=5000
DISCORD_MAX_RETRIES=3
DISCORD_NOTIFICATION_BATCH_SIZE=25
LISTING_NEW_DAYS=7
POSTING_STALE_DAYS=7
